# Copy to .env and fill in your own testnet accounts. NEVER commit .env.
# All values here are placeholders for a NEAR testnet deployment.
# The owner account must already exist on testnet (create one with the
# testnet faucet: `near account create-account sponsor-by-faucet-service`).

# Account that owns the vault and approves large spends.
OWNER_ACCOUNT=owner.testnet
# Account the AI agent uses (holds only a function-call key to the vault).
AGENT_ACCOUNT=agent.testnet
# The vault contract account (a sub-account of the owner).
VAULT_ACCOUNT=vault.owner.testnet

# Policy defaults used by scripts/deploy.sh (amounts in NEAR).
# The testnet faucet funds 10 NEAR per account; the demo is sized to fit.
DAILY_LIMIT_NEAR=2
APPROVAL_THRESHOLD_NEAR=1
INITIAL_DEPOSIT_NEAR=4
# Funding for the two sub-accounts created by scripts/deploy.sh.
VAULT_FUNDING_NEAR=5
AGENT_FUNDING_NEAR=0.5
